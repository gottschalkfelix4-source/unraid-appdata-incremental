<!-- Generated by build.py from plugin/appdata-incremental.plg.in – do not edit by hand. -->
<!DOCTYPE PLUGIN [
<!ENTITY name      "appdata-incremental">
<!ENTITY author    "gottschalkfelix4-source">
<!ENTITY version   "2026.11.16">
<!ENTITY gitRef    "c8479ad4479150318fe0aea413bac552cc3397fe">
<!ENTITY repoURL   "https://github.com/gottschalkfelix4-source/unraid-appdata-incremental">
<!ENTITY rawURL    "https://raw.githubusercontent.com/gottschalkfelix4-source/unraid-appdata-incremental">
<!ENTITY pluginURL "&rawURL;/main/&name;.plg">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY resticVer "0.19.1">
<!ENTITY resticSHA "f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="&repoURL;/issues" min="7.0.0" icon="archive">

<CHANGES>
###2026.11.16
- Erste Version (MVP, nur Kommandozeile): Kern-CLI `aib`, restic 0.19.1
- Alle Docker-Container werden erkannt, auch ohne Unraid-Vorlage
- Kurze Ausfallzeit: Container stoppen → btrfs/ZFS-Snapshot → starten → aus dem Snapshot sichern
- Appdata, die auf mehrere Pools verteilt ist, wird vollständig gesichert und wiederhergestellt
- Ausschlüsse, Gruppen, Reihenfolge und Aufbewahrung pro Container; Vorlagen für neue Container
- Wiederherstellung ganzer Container (in einen Ordner oder an Ort und Stelle) und einzelner Dateien
- Zeitplan, Log, Unraid-Benachrichtigungen
</CHANGES>

