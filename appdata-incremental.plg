<!-- Install: plugin files from the pinned commit + restic from the official release, both SHA256-checked
     and cached on the flash drive (boot works without internet once installed) -->
<FILE Run="/bin/bash">
<INLINE>
NAME="&name;"; CFG="&plgPATH;"; VER="&version;"; REF="&gitRef;"; RAW="&rawURL;"
RV="&resticVer;"; RSHA="&resticSHA;"
fail() { echo "FEHLER: $*"; exit 1; }
PKG="$CFG/pkg/$VER"; MAN="$CFG/manifest-$VER.sha256"
mkdir -p "$PKG" "$CFG/bin" "$CFG/secrets" "$CFG/logs" "/var/lib/$NAME" "/var/log/$NAME"

# 1. plugin files
while read -r SUM REL; do
  [ -z "$SUM" ] &amp;&amp; continue
  F="$PKG/$REL"
  if [ -f "$F" ] &amp;&amp; echo "$SUM  $F" | sha256sum -c --status - ; then continue; fi
  mkdir -p "$(dirname "$F")"
  curl -fsSL --retry 3 -o "$F.tmp" "$RAW/$REF/src/$REL" || { rm -f "$F.tmp"; fail "Download von $REL fehlgeschlagen"; }
  echo "$SUM  $F.tmp" | sha256sum -c --status - || { rm -f "$F.tmp"; fail "Prüfsumme von $REL stimmt nicht"; }
  mv "$F.tmp" "$F"
done &lt; "$MAN"
[ -f "$PKG/usr/local/emhttp/plugins/$NAME/scripts/aib" ] || fail "Plugin-Dateien unvollständig"

# 2. restic
BIN="$CFG/bin/restic-$RV"
if [ ! -s "$BIN" ]; then
  echo "Lade restic $RV ..."
  TMP=$(mktemp -d)
  curl -fsSL --retry 3 -o "$TMP/restic.bz2" "https://github.com/restic/restic/releases/download/v$RV/restic_${RV}_linux_amd64.bz2" || { rm -rf "$TMP"; fail "restic-Download fehlgeschlagen"; }
  echo "$RSHA  $TMP/restic.bz2" | sha256sum -c --status - || { rm -rf "$TMP"; fail "Prüfsumme von restic stimmt nicht"; }
  bunzip2 -c "$TMP/restic.bz2" > "$BIN.tmp" || { rm -rf "$TMP" "$BIN.tmp"; fail "restic konnte nicht entpackt werden"; }
  mv "$BIN.tmp" "$BIN"
  rm -rf "$TMP"
fi

# 3. activate
rm -rf "/usr/local/emhttp/plugins/$NAME"
cp -r "$PKG/usr/local/emhttp/plugins/$NAME" /usr/local/emhttp/plugins/ || fail "Plugin-Dateien konnten nicht kopiert werden"
echo "$VER" > "/usr/local/emhttp/plugins/$NAME/VERSION"
chmod 0755 "/usr/local/emhttp/plugins/$NAME/scripts/aib"
ln -sf "/usr/local/emhttp/plugins/$NAME/scripts/aib" /usr/local/sbin/aib
install -m 0755 "$BIN" /usr/local/bin/aib-restic || fail "restic konnte nicht installiert werden"
/usr/local/bin/aib-restic version >/dev/null 2>&amp;1 || fail "restic startet nicht"

# 4. clean up older versions on the flash drive
find "$CFG/pkg" -mindepth 1 -maxdepth 1 ! -name "$VER" -exec rm -rf {} +
find "$CFG" -maxdepth 1 -name 'manifest-*.sha256' ! -name "manifest-$VER.sha256" -delete
find "$CFG/bin" -name 'restic-*' ! -name "restic-$RV" -delete

if [ -f "$CFG/config.json" ]; then
  /usr/local/sbin/aib schedule apply
else
  echo "Noch keine Konfiguration. Weiter mit: aib config sync, dann aib doctor"
fi
echo "Appdata Incremental $VER installiert (restic $(/usr/local/bin/aib-restic version | cut -d' ' -f2))."
</INLINE>
</FILE>

<!-- Uninstall: program files go; configuration, keys, logs and the restic repository stay -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
NAME="&name;"; CFG="&plgPATH;"
rm -f "$CFG/$NAME.cron"
[ -x /usr/local/sbin/update_cron ] &amp;&amp; /usr/local/sbin/update_cron
rm -f /usr/local/sbin/aib /usr/local/bin/aib-restic "$CFG"/manifest-*.sha256
rm -rf "/usr/local/emhttp/plugins/$NAME" "/var/lib/$NAME" "$CFG/pkg"
echo "Appdata Incremental entfernt. Konfiguration, Schlüssel und Logs bleiben in $CFG; das restic-Repository bleibt unverändert."
</INLINE>
</FILE>

</PLUGIN>
