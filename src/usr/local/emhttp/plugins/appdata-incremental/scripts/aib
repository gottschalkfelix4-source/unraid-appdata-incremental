#!/usr/bin/php
<?php
declare(strict_types=1);

namespace Aib;

foreach (['Util', 'Config', 'Docker', 'Storage', 'Restic', 'Backup', 'Restore', 'Admin'] as $f) require __DIR__ . "/../include/$f.php";

const HELP = <<<TXT
aib – Appdata Incremental (restic) für Unraid

Einrichtung & Prüfung
  aib doctor                    Voraussetzungen, Konfiguration und Pfade prüfen (ändert nichts)
  aib config sync               neue Container mit Voreinstellungen in config.json eintragen
  aib config show|validate|path Konfiguration anzeigen / prüfen / Pfad ausgeben
  aib containers [--json]       alle Container mit Auswahl, Pfaden und Ausschlüssen
  aib set <name> k=v ...        Container-Einstellung ändern, z. B. enabled=nein stop=ja
                                group=db order=10 excludes=cache,logs excludes+=tmp
  aib plan [--container N]...   zeigt, was ein Lauf tun würde (nichts wird gestoppt)
  aib selftest-snapshot <pfad>  Snapshot + Bind-Mount für einen Pfad testen (kein Container-Stopp)
  aib init                      restic-Repository anlegen
  aib test-repo                 Verbindung zum Repository prüfen

Sichern
  aib backup [--container N]... [--dry-run] [--no-forget]
  aib cron                      geplanter Lauf: backup + forget (+ prune/check nach Zeitplan)
  aib forget | prune | check [--subset 5%] | unlock
  (Jobs zusätzlich mit --quiet: keine Ausgabe, nur Log – so startet die WebGUI)
  aib schedule enable|disable|show   Zeitplan ein/aus (Zeit: schedule.backup in config.json)
  aib cleanup-snapshots         übrig gebliebene Snapshots abgebrochener Läufe löschen

Verlauf & Wiederherstellung
  aib snapshots [--container N] [--json]
  aib ls <snapshot> [pfad]
  aib diff <snapshotA> <snapshotB>
  aib restore-files <snapshot> --target <ordner> [--include <pfad>]...
  aib restore-files <snapshot> --in-place --yes --include <pfad>... [--stop <container>]...
  aib restore-container <name> [--snapshot ID|latest] --target <ordner>
  aib restore-container <name> [--snapshot ID|latest] --in-place --yes [--stop-dependents]

Status
  aib status [--json] | aib log | aib version

TXT;

function parseArgs(array $argv): array
{
    $pos = []; $opt = [];
    $multi = ['container', 'include', 'stop'];
    for ($i = 0; $i < count($argv); $i++) {
        $a = $argv[$i];
        if (str_starts_with($a, '--')) {
            $k = substr($a, 2); $v = true;
            if (str_contains($k, '=')) [$k, $v] = explode('=', $k, 2);
            elseif (in_array($k, ['container', 'include', 'target', 'snapshot', 'subset', 'stop'], true)) $v = $argv[++$i] ?? '';
            if (in_array($k, $multi, true)) $opt[$k][] = $v; else $opt[$k] = $v;
        } else {
            $pos[] = $a;
        }
    }
    return [$pos, $opt];
}

function out(string $s): void { fwrite(STDOUT, $s); }

function needLock(): void
{
    if (!Lock::acquire()) throw new \RuntimeException('Es läuft bereits ein Vorgang (Sperre ' . Env::stateDir() . '/aib.lock)');
}

/** Copy the run log to the flash drive and keep the newest N. */
function persistLog(Config $cfg): void
{
    $f = Log::file();
    if (!$f || !is_file($f)) return;
    $dir = Env::cfgDir() . '/logs';
    if (!is_dir($dir)) @mkdir($dir, 0755, true);
    @copy($f, $dir . '/' . basename($f));
    $logs = glob($dir . '/*.log') ?: [];
    sort($logs);
    $keep = max(1, (int)$cfg->get('log_keep', 14));
    foreach (array_slice($logs, 0, max(0, count($logs) - $keep)) as $old) @unlink($old);
}

function finishRun(Config $cfg, string $kind, bool $ok, array $results, float $t0, bool $notifySuccess = false, string $trigger = 'manuell'): void
{
    $level = !$ok || Log::$errors ? 'error' : (Log::$warnings ? 'warning' : 'ok');
    foreach ($results as &$r) if (($r['status'] ?? '') === 'pending') $r['status'] = 'cancelled';
    unset($r);
    $dur = (int)round(microtime(true) - $t0);
    $summary = sprintf('%s %s nach %s (%d Fehler, %d Warnungen)', $kind, $level === 'ok' ? 'erfolgreich' : ($level === 'warning' ? 'mit Warnungen' : 'FEHLGESCHLAGEN'), gmdate('H:i:s', $dur), Log::$errors, Log::$warnings);
    Log::info($summary);
    $last = [
        'kind' => $kind, 'trigger' => $trigger, 'started' => State::read()['started'] ?? null, 'finished' => date('c'), 'result' => $level, 'duration' => $dur,
        'errors' => Log::$errors, 'warnings' => Log::$warnings, 'log' => Log::file(), 'containers' => $results,
        'data_added' => array_sum(array_map(fn($r) => (int)($r['data_added'] ?? 0), $results)),
    ];
    $hist = (array)(State::read()['history'] ?? []);
    array_unshift($hist, array_merge($last, ['log' => Log::file() ? basename(Log::file()) : null]));
    State::update(['running' => false, 'phase' => 'idle', 'current' => null, 'progress' => null, 'last' => $last,
                   'history' => array_slice($hist, 0, 100)]);
    if ($level !== 'error' && in_array($kind, ['Backup', 'Aufbewahrung', 'Aufräumen (prune)'], true)) {
        try { RepoStats::refresh($cfg); } catch (\Throwable $e) { Log::debug('stats: ' . $e->getMessage()); }
    }
    $n = $cfg->get('notify');
    $detail = implode('; ', array_slice(Log::$problems, 0, 5));
    if ($level === 'error' && $n['on_error']) Notify::send('error', "Appdata Incremental: $kind fehlgeschlagen", $detail ?: $summary);
    elseif ($level === 'warning' && $n['on_warning']) Notify::send('warning', "Appdata Incremental: $kind mit Warnungen", $detail ?: $summary);
    elseif ($level === 'ok' && ($n['on_success'] || $notifySuccess)) Notify::send('normal', "Appdata Incremental: $kind erfolgreich", $summary);
    persistLog($cfg);
}

/** Run a logged job: lock, state, signals, summary, notification. */
function runJob(Config $cfg, string $logKind, string $label, callable $fn, bool $echo = true): int
{
    needLock();
    $t0 = microtime(true);
    Log::open($logKind);
    Log::$echo = $echo;
    State::update(['running' => true, 'pid' => getmypid(), 'started' => date('c'), 'phase' => $logKind, 'kind' => $label, 'current' => null, 'progress' => null]);
    if (function_exists('pcntl_async_signals')) {
        pcntl_async_signals(true);
        $h = function (int $sig) { throw new \RuntimeException("Abbruch durch Signal $sig"); };
        pcntl_signal(SIGTERM, $h); pcntl_signal(SIGINT, $h); pcntl_signal(SIGHUP, $h);
    }
    $ok = false; $results = [];
    try {
        $ok = (bool)$fn($results);
    } catch (\Throwable $e) {
        Log::error($e->getMessage());
        $ok = false;
    } finally {
        finishRun($cfg, $label, $ok, $results, $t0, $logKind === 'restore');
        Log::close();
    }
    return $ok ? 0 : 1;
}

function doctor(Config $cfg): int
{
    $bad = 0;
    foreach (Doctor::run($cfg) as $l) {
        if (!$l['ok']) $bad++;
        out(sprintf("[%s] %s%s\n", $l['ok'] ? ' OK ' : 'FEHL', $l['what'], $l['info'] !== '' ? " – {$l['info']}" : ''));
    }
    try {
        $b = new Backup($cfg, new Restic($cfg));
        out("\n" . $b->describePlan($b->plan()));
    } catch (\Throwable $e) {
        $bad++;
        out('Plan: ' . $e->getMessage() . "\n");
    }
    return $bad ? 1 : 0;
}

function containersTable(Config $cfg, bool $json): void
{
    $rows = [];
    foreach (Docker::list() as $n => $info) {
        $s = $cfg->containerSettings($n, $info);
        $paths = [];
        foreach ($info['mounts'] as $m) {
            if ($cfg->isAppdataPath($m['source'])) $paths = array_merge($paths, Storage::resolve($m['source'], $cfg)['paths']);
        }
        $rows[] = ['name' => $n, 'running' => $info['running'], 'image' => $info['image'], 'enabled' => $s['enabled'], 'stop' => $s['stop'],
                   'group' => $s['group'], 'order' => $s['order'], 'excludes' => $s['excludes'], 'paths' => Storage::dedupe($paths),
                   'source' => $s['source'], 'note' => $s['note']];
    }
    if ($json) { out(json_encode($rows, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"); return; }
    foreach ($rows as $r) {
        out(sprintf("%-32s %-8s sichern=%-4s stoppen=%-4s gruppe=%-10s %s\n", $r['name'], $r['running'] ? 'läuft' : 'gestoppt',
            $r['enabled'] ? 'ja' : 'nein', $r['stop'] ? 'ja' : 'nein', $r['group'] ?: '-', $r['source'] !== 'config' ? "[{$r['source']}]" : ''));
        foreach ($r['paths'] as $p) out("    $p\n");
        if ($r['excludes']) out('    Ausschlüsse: ' . implode(', ', $r['excludes']) . "\n");
        if ($r['note']) out("    Hinweis: {$r['note']}\n");
    }
}

function selftestSnapshot(Config $cfg, string $path): int
{
    $r = Doctor::selftest($cfg, $path);
    out(implode("\n", $r['log']) . "\n");
    return $r['ok'] ? 0 : 1;
}

function main(array $argv): int
{
    [$pos, $opt] = parseArgs(array_slice($argv, 1));
    $cmd = $pos[0] ?? 'help';
    if (in_array($cmd, ['help', '-h', '--help'], true)) { out(HELP); return 0; }
    if ($cmd === 'version') { out(VERSION . "\n"); return 0; }

    $cfg = Config::load();
    $restic = new Restic($cfg);
    $only = $opt['container'] ?? null;

    switch ($cmd) {
        case 'doctor':
            return doctor($cfg);

        case 'config':
            $sub = $pos[1] ?? 'show';
            if ($sub === 'path') { out(Config::file() . "\n"); return 0; }
            if ($sub === 'show') { out(json_encode($cfg->data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"); return 0; }
            if ($sub === 'validate') { $v = $cfg->validate(); out($v ? implode("\n", $v) . "\n" : "OK\n"); return $v ? 1 : 0; }
            if ($sub === 'sync') {
                $added = $cfg->sync(Docker::list());
                $cfg->save();
                out($added ? "Neu eingetragen: " . implode(', ', $added) . "\n" : "Keine neuen Container.\n");
                out('Konfiguration: ' . Config::file() . "\n");
                return 0;
            }
            throw new \RuntimeException("Unbekannt: config $sub");

        case 'containers':
            containersTable($cfg, isset($opt['json']));
            return 0;

        case 'set':
            $name = $pos[1] ?? null;
            if ($name === null || count($pos) < 3) throw new \RuntimeException('Aufruf: aib set <container> schlüssel=wert ... (enabled, stop, group, order, excludes, extra_paths, skip_paths, note)');
            $docker = Docker::list();
            if (!isset($docker[$name]) && !$cfg->hasContainer($name)) throw new \RuntimeException("Container $name nicht gefunden");
            if (!$cfg->hasContainer($name)) $cfg->sync(array_intersect_key($docker, [$name => true]));
            $c = &$cfg->data['containers'][$name];
            foreach (array_slice($pos, 2) as $kv) {
                if (!str_contains($kv, '=')) throw new \RuntimeException("Erwartet schlüssel=wert: $kv");
                [$k, $v] = explode('=', $kv, 2);
                $bool = fn($v) => in_array(strtolower($v), ['1', 'true', 'yes', 'ja', 'on'], true) ? true
                    : (in_array(strtolower($v), ['0', 'false', 'no', 'nein', 'off'], true) ? false : throw new \RuntimeException("$k: ja/nein erwartet"));
                $list = fn($v) => array_values(array_filter(array_map('trim', explode(',', $v)), 'strlen'));
                switch ($k) {
                    case 'enabled': case 'stop': $c[$k] = $bool($v); break;
                    case 'order': $c[$k] = (int)$v; break;
                    case 'group': case 'note': $c[$k] = $v; break;
                    case 'excludes': case 'extra_paths': case 'skip_paths': $c[$k] = $list($v); break;
                    case 'excludes+': $c['excludes'] = array_values(array_unique(array_merge((array)$c['excludes'], $list($v)))); break;
                    default: throw new \RuntimeException("Unbekannter Schlüssel: $k");
                }
            }
            unset($c);
            if ($p = $cfg->validate()) throw new \RuntimeException(implode('; ', $p));
            $cfg->save();
            out(json_encode([$name => $cfg->data['containers'][$name]], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
            return 0;

        case 'plan':
            out((new Backup($cfg, $restic))->describePlan((new Backup($cfg, $restic))->plan($only)));
            return 0;

        case 'selftest-snapshot':
            if (!isset($pos[1])) throw new \RuntimeException('Pfad fehlt');
            return selftestSnapshot($cfg, $pos[1]);

        case 'init':
        case 'test-repo':
            if ($p = $restic->checkReady()) throw new \RuntimeException(implode('; ', $p));
            $sub = ['init' => ['init'], 'test-repo' => ['cat', 'config']][$cmd];
            [$c, $o, $e] = $restic->run($sub, null, false);
            out($o . $e);
            if ($cmd === 'test-repo' && $c === 0) out("Repository erreichbar.\n");
            return $c;

        case 'backup':
        case 'cron':
            if ($p = $restic->checkReady()) throw new \RuntimeException(implode('; ', $p));
            needLock();
            $dry = isset($opt['dry-run']);
            $t0 = microtime(true);
            Log::open($cmd);
            Log::$echo = $cmd !== 'cron' && !isset($opt['quiet']);
            State::update(['running' => true, 'pid' => getmypid(), 'started' => date('c'), 'phase' => 'start', 'kind' => $dry ? 'Testlauf' : 'Backup', 'current' => null, 'progress' => null]);
            $b = new Backup($cfg, $restic, $dry);
            $ok = false;
            if (function_exists('pcntl_async_signals')) {
                pcntl_async_signals(true);
                $h = function (int $sig) { throw new \RuntimeException("Abbruch durch Signal $sig"); };
                pcntl_signal(SIGTERM, $h); pcntl_signal(SIGINT, $h); pcntl_signal(SIGHUP, $h);
            }
            try {
                $restic->run(['unlock']); // removes stale locks only
                $ok = $b->run($only);
                if (!$dry && !isset($opt['no-forget'])) {
                    State::update(['phase' => 'forget']);
                    $ok = $b->forget() && $ok;
                }
                if ($cmd === 'cron' && !$dry) {
                    $wd = (int)$cfg->get('schedule.prune_weekday', 0);
                    if ($wd >= 0 && (int)date('w') === $wd) {
                        State::update(['phase' => 'prune']);
                        Log::info('Wöchentliches prune');
                        [$c] = $restic->run(['prune']);
                        if ($c !== 0) { $ok = false; Log::error("prune fehlgeschlagen (Exit $c)"); }
                    }
                    $cd = (int)$cfg->get('schedule.check_day', 1);
                    if ($cd > 0 && (int)date('j') === $cd) {
                        State::update(['phase' => 'check']);
                        $subset = (string)$cfg->get('schedule.check_subset', '2%');
                        Log::info("Monatliche Prüfung (check --read-data-subset $subset)");
                        [$c] = $restic->run(['check', '--read-data-subset', $subset]);
                        if ($c !== 0) { $ok = false; Log::error("check meldet Probleme (Exit $c)"); }
                    }
                }
            } catch (\Throwable $e) {
                Log::error($e->getMessage());
                $ok = false;
            } finally {
                finishRun($cfg, $dry ? 'Testlauf' : 'Backup', $ok, $b->results, $t0, false, $cmd === 'cron' ? 'geplant' : 'manuell');
                Log::close();
            }
            return $ok ? 0 : 1;

        case 'forget':
        case 'prune':
        case 'check':
        case 'unlock':
            if ($p = $restic->checkReady()) throw new \RuntimeException(implode('; ', $p));
            $labels = ['forget' => 'Aufbewahrung', 'prune' => 'Aufräumen (prune)', 'check' => 'Prüfung (check)', 'unlock' => 'Sperren lösen'];
            return runJob($cfg, $cmd, $labels[$cmd], function () use ($cmd, $cfg, $restic, $opt) {
                if ($cmd === 'forget') return (new Backup($cfg, $restic))->forget();
                if ($cmd === 'prune') $c = $restic->run(['prune'])[0];
                elseif ($cmd === 'unlock') $c = $restic->run(['unlock'])[0];
                else $c = $restic->run(['check', '--read-data-subset', (string)($opt['subset'] ?? $cfg->get('schedule.check_subset', '2%'))])[0];
                if ($c !== 0) Log::error("$cmd fehlgeschlagen (Exit $c)");
                return $c === 0;
            }, !isset($opt['quiet']));

        case 'snapshots':
            $snaps = $restic->snapshots($only[0] ?? null);
            if (isset($opt['json'])) { out(json_encode($snaps, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"); return 0; }
            out(sprintf("%-10s %-20s %-28s %12s %12s %8s %8s\n", 'ID', 'Zeit', 'Container', 'Gesamt', 'Neu', 'neu', 'geänd.'));
            foreach ($snaps as $s) {
                $sum = $s['summary'] ?? [];
                out(sprintf("%-10s %-20s %-28s %12s %12s %8s %8s\n", $s['short_id'] ?? substr($s['id'], 0, 8), date('Y-m-d H:i:s', strtotime($s['time'])),
                    Restic::containerOf($s) ?? '-', isset($sum['total_bytes_processed']) ? Fs::human((float)$sum['total_bytes_processed']) : '-',
                    isset($sum['data_added']) ? Fs::human((float)$sum['data_added']) : '-', $sum['files_new'] ?? '-', $sum['files_changed'] ?? '-'));
            }
            return 0;

        case 'ls':
            if (!isset($pos[1])) throw new \RuntimeException('Snapshot fehlt');
            [$c, $o, $e] = $restic->run(array_merge(['ls', '--long', $pos[1]], array_slice($pos, 2)), null, false);
            out($o . $e);
            return $c;

        case 'diff':
            if (!isset($pos[2])) throw new \RuntimeException('Zwei Snapshots angeben');
            [$c, $o, $e] = $restic->run(['diff', $pos[1], $pos[2]], null, false);
            out($o . $e);
            return $c;

        case 'restore-files':
            if (!isset($pos[1])) throw new \RuntimeException('Aufruf: aib restore-files <snapshot> (--target <ordner> | --in-place --yes [--stop <container>]...) --include <pfad>...');
            $snap = V::snapshotId($pos[1]);
            $inc = array_map(fn($x) => V::absPath((string)$x), $opt['include'] ?? []);
            $r = new Restore($cfg, $restic);
            if (isset($opt['in-place'])) {
                if (!$inc) throw new \RuntimeException('--include <pfad> angeben');
                if (!isset($opt['yes'])) { out("Würde an Ort und Stelle wiederherstellen (alter Stand → <name>.aib-pre-restore-<zeit>):\n  " . implode("\n  ", $inc) . "\nZum Ausführen --yes anhängen.\n"); return 2; }
                $stop = array_map(fn($x) => V::containerName((string)$x), $opt['stop'] ?? []);
                return runJob($cfg, 'restore', 'Wiederherstellung', fn() => $r->filesInPlace($snap, $inc, $stop), !isset($opt['quiet']));
            }
            if (empty($opt['target']) || !is_string($opt['target'])) throw new \RuntimeException('--target <ordner> oder --in-place angeben');
            $target = V::absPath($opt['target'], 'Zielordner');
            return runJob($cfg, 'restore', 'Wiederherstellung', fn() => $r->restoreFiles($snap, $target, $inc), !isset($opt['quiet']));

        case 'restore-container':
            $name = V::containerName((string)($pos[1] ?? ''));
            $which = V::snapshotId(is_string($opt['snapshot'] ?? null) ? $opt['snapshot'] : 'latest');
            $r = new Restore($cfg, $restic);
            if (!empty($opt['target']) && is_string($opt['target'])) {
                $target = V::absPath($opt['target'], 'Zielordner');
                return runJob($cfg, 'restore', "Wiederherstellung $name", fn() => $r->containerToTarget($name, $which, $target), !isset($opt['quiet']));
            }
            if (isset($opt['in-place'])) {
                if (!isset($opt['yes'])) {
                    $s = $r->findSnapshot($name, $which);
                    out("Würde $name aus Snapshot " . substr($s['id'], 0, 8) . " vom {$s['time']} an Ort und Stelle wiederherstellen:\n");
                    foreach ($s['paths'] as $p) out("  $p\n");
                    out("Der aktuelle Stand wird nach <pfad>/.aib-pre-restore-<zeit> verschoben (nicht gelöscht).\nZum Ausführen --yes anhängen.\n");
                    return 2;
                }
                return runJob($cfg, 'restore', "Wiederherstellung $name", fn() => $r->containerInPlace($name, $which, isset($opt['stop-dependents'])), !isset($opt['quiet']));
            }
            throw new \RuntimeException('--target <ordner> oder --in-place angeben');

        case 'schedule':
            $sub = $pos[1] ?? 'show';
            if ($sub === 'show') { out(is_file(Schedule::cronFile()) ? file_get_contents(Schedule::cronFile()) : "Kein Zeitplan aktiv.\n"); return 0; }
            if ($sub === 'enable' || $sub === 'disable') {
                if (!is_file(Config::file())) throw new \RuntimeException('Erst Konfiguration anlegen: aib config sync');
                $cfg->data['schedule']['enabled'] = $sub === 'enable';
                $cfg->save();
            } elseif ($sub !== 'apply') {
                throw new \RuntimeException('aib schedule enable|disable|apply|show');
            }
            out(Schedule::apply($cfg) . "\n");
            return 0;

        case 'cleanup-snapshots':
            needLock();
            Storage::cleanupStale($cfg);
            out("Fertig.\n");
            return 0;

        case 'status':
            $s = State::read();
            if (isset($opt['json'])) { out(json_encode($s, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n"); return 0; }
            $running = !empty($s['running']) && !empty($s['pid']) && file_exists('/proc/' . $s['pid']);
            out($running ? "Läuft seit {$s['started']} – Phase {$s['phase']}" . (!empty($s['current']) ? " ({$s['current']})" : '') . "\n" : "Kein Lauf aktiv.\n");
            if (!empty($s['last'])) {
                $l = $s['last'];
                out("Letzter Lauf: {$l['kind']} {$l['finished']} – {$l['result']}, {$l['errors']} Fehler, {$l['warnings']} Warnungen, Dauer {$l['duration']}s\nLog: {$l['log']}\n");
                foreach ((array)($l['containers'] ?? []) as $n => $r) {
                    out(sprintf("  %-30s %-8s neu %-10s Ausfall %ss\n", $n, $r['status'], isset($r['data_added']) ? Fs::human((float)$r['data_added']) : '-', $r['downtime'] ?? 0));
                }
            }
            return 0;

        case 'log':
            $f = Env::logDir() . '/latest.log';
            out(is_file($f) ? file_get_contents($f) : "Noch kein Log.\n");
            return 0;
    }
    throw new \RuntimeException("Unbekannter Befehl: $cmd (aib help)");
}

try {
    exit(main($argv));
} catch (\Throwable $e) {
    fwrite(STDERR, 'Fehler: ' . $e->getMessage() . "\n");
    exit(1);
}
