<div id="aib-restore" class="aib-wrap">
  <div class="title"><span class="left"><i class="fa fa-undo title"></i>Wiederherstellen</span></div>
  <dl><dt>Container:</dt><dd><select id="aib-x-ct"><option value="">– lädt –</option></select></dd></dl>
  <dl><dt>Version:</dt><dd><select id="aib-x-ver" style="min-width:320px"></select></dd></dl>
