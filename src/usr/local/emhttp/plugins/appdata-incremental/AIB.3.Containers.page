  <div class="aib-row">
    <input type="button" id="aib-ct-save" value="Speichern">
    <input type="button" id="aib-ct-reload" value="Neu laden">
    <input type="button" id="aib-ct-all" value="Alle sichern">
    <input type="button" id="aib-ct-none" value="Keine sichern">
